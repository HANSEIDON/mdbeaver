# Copy to .env (never commit .env). Values here are placeholders.

# --- Gateway (Oracle server: /etc/mdbeaver/gateway.env) ---
MDB_WORKER_TOKEN=change-me-long-random-string
MDB_UPLOAD_DIR=/var/lib/mdbeaver/uploads
MDB_MAX_UPLOAD_MB=50
MDB_MAX_QUEUE=100
MDB_JOBS_PER_IP_PER_HOUR=30
MDB_RESULT_TTL_SEC=600
MDB_JOB_TIMEOUT_SEC=900

# --- Worker (home GPU PC: worker/.env) ---
MDB_GATEWAY_URL=https://mdbeaver.com
# MDB_WORKER_TOKEN must match the gateway value
MDB_ENGINE=basic
