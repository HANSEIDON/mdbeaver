# Private notes (handoff docs, server details) — never commit
private/

# Secrets — never commit
.env
*.env
!*.env.example
*.key
*.pem
*.p12
secrets/

# User data / runtime
uploads/
outputs/
results/
logs/
*.log

# Benchmark inputs (copyrighted/private documents) — results/ stay committed
bench/docs/
bench/baselines/
bench/out/
!bench/results/

# Models & caches
models/
*.safetensors
*.onnx
*.pdparams
.cache/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / vendored frontend libs (regenerated by `npm run vendor`)
node_modules/
web/vendor/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# MinerU API runtime data (worker/mineru-server.sh keeps it in ~/mdb/mineru-data)
blobs/
.mineru-service.lock
