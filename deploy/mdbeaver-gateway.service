[Unit]
Description=mdbeaver gateway API
After=network-online.target

[Service]
User=mdbeaver
Group=mdbeaver
WorkingDirectory=/opt/mdbeaver/gateway
EnvironmentFile=/etc/mdbeaver/gateway.env
ExecStart=/opt/mdbeaver/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-access-log --no-server-header
Restart=always
RestartSec=3

StateDirectory=mdbeaver
# Coupons and uploads are for this service only, not for other accounts on the server.
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/mdbeaver

[Install]
WantedBy=multi-user.target
